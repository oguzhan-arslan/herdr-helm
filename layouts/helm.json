{
  "id": "root",
  "type": "column",
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "children": [
    {
      "id": "bar",
      "type": "block",
      "size": {
        "px": 42
      },
      "window_drag": true,
      "content": {
        "mod": "helm-bar"
      }
    },
    {
      "id": "work-body",
      "type": "row",
      "children": [
        {
          "id": "grid",
          "type": "row",
          "gap": 8,
          "children": []
        },
        {
          "id": "panel",
          "type": "stack",
          "active": "files",
          "size": {
            "px": 368
          },
          "min": 280,
          "max": 900,
          "hidden": true,
          "children": [
            {
              "id": "files",
              "type": "block",
              "content": {
                "mod": "helm-files"
              }
            },
            {
              "id": "changes",
              "type": "block",
              "content": {
                "mod": "helm-changes"
              }
            }
          ]
        }
      ],
      "padding": 8,
      "gap": 8
    },
    {
      "id": "jobs-run",
      "type": "block",
      "size": {
        "px": 0
      },
      "content": {
        "mod": "helm-jobs"
      }
    }
  ]
}
